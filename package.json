{
  "name": "@q78kg/rmgaf",
  "version": "1.1.0",
  "description": "RPG Maker MV/MZ resource filename case checker with opt-in trusted JavaScript decoding",
  "bin": "dist/cli.mjs",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "yarn build"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-loose": "^8.5.2",
    "acorn-walk": "^8.3.5",
    "eslint-scope": "^9.1.2",
    "htmlparser2": "^12.0.0",
    "moejs-wasm": "1.0.0-beta.2",
    "postcss": "^8.5.29",
    "postcss-value-parser": "^4.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/eslint-scope": "^9.1.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@4.18.1"
}
